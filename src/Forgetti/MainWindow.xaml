<Window x:Class="Forgetti.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Forgetti"
        xmlns:ui="clr-namespace:Forgetti.Ui"
        Title="Forgetti"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Forgetti.Background}"
        Foreground="{DynamicResource Forgetti.Foreground}"
        FontFamily="{DynamicResource Forgetti.FontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- One Revit version: a tick box with the name, and a tag saying what is there to forget. -->
    <DataTemplate DataType="{x:Type local:InstallRow}">
      <Border x:Name="Row"
              Padding="14,11"
              Background="Transparent"
              BorderBrush="{DynamicResource Forgetti.Border}"
              BorderThickness="0,2,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox IsChecked="{Binding IsSelected}"
                    IsEnabled="{Binding HasFiles}"
                    Content="{Binding Name}"
                    VerticalAlignment="Center" />

          <Border x:Name="Tag"
                  Grid.Column="1"
                  Margin="12,0,0,0"
                  Padding="8,3"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Forgetti.SurfaceAlt}"
                  BorderBrush="{DynamicResource Forgetti.Border}"
                  BorderThickness="2">
            <TextBlock x:Name="TagText"
                       ui:Tracking.Text="{Binding Summary}"
                       ui:Tracking.Amount="0.08"
                       FontSize="10"
                       FontWeight="Bold" />
          </Border>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <!-- The first row has no rule above it; the card's own outline does that job. -->
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Row" Property="BorderThickness" Value="0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Empty">
          <Setter TargetName="Tag" Property="Background" Value="Transparent" />
          <Setter TargetName="Tag" Property="BorderThickness" Value="0" />
          <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="Cleared">
          <Setter TargetName="Tag" Property="Background" Value="{DynamicResource Forgetti.Accent}" />
          <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource Forgetti.AccentForeground}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="EmptyState" TargetType="{x:Type StackPanel}">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasInstalls}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Forgetti.ForegroundMuted}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Success">
          <Setter Property="Foreground" Value="{DynamicResource Forgetti.Success}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Foreground" Value="{DynamicResource Forgetti.Error}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Background="{DynamicResource Forgetti.Background}" LastChildFill="True">

    <!-- Footer: status on the left, the two buttons on the right. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Forgetti.Surface}"
            BorderBrush="{DynamicResource Forgetti.Border}"
            BorderThickness="0,2,0,0"
            Padding="24,14,24,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Undo"
                  Command="{Binding UndoCommand}"
                  MinWidth="88"
                  Margin="0,0,10,0"
                  Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Forget"
                  Style="{StaticResource Forgetti.PrimaryButton}"
                  Command="{Binding ForgetCommand}"
                  MinWidth="120"
                  IsDefault="True" />
        </StackPanel>
        <TextBlock Style="{StaticResource StatusText}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0" />
      </DockPanel>
    </Border>

    <StackPanel Margin="24,22,24,22">

      <!-- Wordmark, tagline, and the paper/ink switch. -->
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
          <TextBlock ui:Tracking.Text="Ink"
                     ui:Tracking.Amount="0.1"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Forgetti.ForegroundMuted}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <ToggleButton Style="{StaticResource Forgetti.ToggleSwitch}"
                        IsChecked="{Binding IsDark}"
                        ToolTip="Paper or ink" />
        </StackPanel>

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="18" Height="18"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Forgetti.Accent}"
                    BorderBrush="{DynamicResource Forgetti.Border}"
                    BorderThickness="2"
                    Effect="{DynamicResource Forgetti.ControlShadow}" />
            <TextBlock ui:Tracking.Text="Forgetti"
                       ui:Tracking.Amount="0.06"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Revit remembers every file you open. Make it forget."
                     Foreground="{DynamicResource Forgetti.ForegroundMuted}"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Shown while Revit is open, because Revit rewrites the list when it exits. -->
      <Border Visibility="{Binding IsRevitRunning, Converter={StaticResource BoolToVisibility}}"
              Margin="0,22,0,0"
              Padding="14,10,14,11"
              Background="{DynamicResource Forgetti.SurfaceAlt}"
              BorderBrush="{DynamicResource Forgetti.Border}"
              BorderThickness="2"
              Effect="{DynamicResource Forgetti.ControlShadow}">
        <StackPanel>
          <TextBlock Text="Revit is open." FontWeight="Bold" />
          <TextBlock Text="Close it first. Revit writes this list back when it exits, so anything forgotten now would come straight back."
                     TextWrapping="Wrap"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- Section header with the select-all links. -->
      <DockPanel Margin="0,22,0,10" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVisibility}}">
          <Button Style="{StaticResource Forgetti.LinkButton}" Content="All" Command="{Binding SelectAllCommand}" />
          <TextBlock Text="/" Foreground="{DynamicResource Forgetti.ForegroundDisabled}" FontSize="11" Margin="7,0" />
          <Button Style="{StaticResource Forgetti.LinkButton}" Content="None" Command="{Binding SelectNoneCommand}" />
        </StackPanel>
        <TextBlock ui:Tracking.Text="Revit versions"
                   ui:Tracking.Amount="0.1"
                   FontSize="11"
                   FontWeight="Bold"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- The list card. -->
      <Border Background="{DynamicResource Forgetti.ControlBackground}"
              BorderBrush="{DynamicResource Forgetti.Border}"
              BorderThickness="2"
              Effect="{DynamicResource Forgetti.ControlShadow}">
        <Grid>
          <ScrollViewer MaxHeight="352"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="False"
                        Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Installs}" />
          </ScrollViewer>

          <StackPanel Style="{StaticResource EmptyState}" Margin="16,16,16,18">
            <TextBlock Text="No Revit here." FontWeight="Bold" />
            <TextBlock Text="Forgetti looks for Revit.ini under %AppData%\Autodesk\Revit. There is nothing there to forget."
                       Foreground="{DynamicResource Forgetti.ForegroundMuted}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="A copy of each Revit.ini is saved beside the original before anything changes, so Undo puts it all back."
                 Foreground="{DynamicResource Forgetti.ForegroundMuted}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Margin="0,16,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
