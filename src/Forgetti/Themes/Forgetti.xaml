<!--
    Forgetti's control styles: Interlude's neubrutalist look, cut down to the controls this
    window uses. Every colour is a DynamicResource lookup of a key Theming/Theme.cs writes at
    run time, which is what makes the paper/ink switch a dictionary update rather than a rebuild.

    The look in one sentence: heavy black outlines, square corners, a solid unblurred shadow
    offset down and to the right, loud flat colour, and type set hard. Press a button and it
    drops onto its own shadow.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Forgetti.FontFamily}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource Forgetti.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Forgetti.FontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Forgetti.Border}"
                  BorderThickness="{DynamicResource Forgetti.BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  Effect="{DynamicResource Forgetti.ControlShadow}"
                  Margin="0,0,6,6">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The plain button. -->
  <Style TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Forgetti.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Forgetti.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Forgetti.BorderThickness}" />
    <Setter Property="FontFamily" Value="{DynamicResource Forgetti.FontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  Effect="{DynamicResource Forgetti.ControlShadow}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Forgetti.ControlBackgroundHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Forgetti.Accent}" />
            </Trigger>
            <!-- Pressing drops the button onto its own shadow: shift it by the offset and take the shadow away. -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
              <Setter TargetName="Surface" Property="RenderTransform" Value="{DynamicResource Forgetti.PressTransform}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Forgetti.ControlBackgroundDisabled}" />
              <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
              <Setter Property="Foreground" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      The loud one. The outline stays black rather than following the accent: the black line
      around a hot-pink button is the entire look.
  -->
  <Style x:Key="Forgetti.PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Forgetti.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.AccentForeground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Surface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  Effect="{DynamicResource Forgetti.ControlShadow}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Forgetti.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
              <Setter TargetName="Surface" Property="RenderTransform" Value="{DynamicResource Forgetti.PressTransform}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Forgetti.ControlBackgroundDisabled}" />
              <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
              <Setter Property="Foreground" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small text that acts: the All / None links. -->
  <Style x:Key="Forgetti.LinkButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource Forgetti.FontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="0,0,0,1">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Forgetti.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Forgetti.Foreground}" />
    <Setter Property="FontFamily" Value="{DynamicResource Forgetti.FontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box"
                    Width="18" Height="18"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Forgetti.ControlBackground}"
                    BorderBrush="{DynamicResource Forgetti.Border}"
                    BorderThickness="{DynamicResource Forgetti.BorderThickness}"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick"
                    Data="M 2.5 7 L 6 10.5 L 12 3.5"
                    Stroke="{DynamicResource Forgetti.AccentForeground}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter x:Name="Label"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Forgetti.Accent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Effect" Value="{DynamicResource Forgetti.ControlShadow}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="Effect" Value="{DynamicResource Forgetti.ControlShadow}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Forgetti.ControlBackgroundDisabled}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Forgetti.ForegroundDisabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- WPF has no switch; a template over a ToggleButton is a few lines and no dependency. -->
  <Style x:Key="Forgetti.ToggleSwitch" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="Track"
                  Background="{DynamicResource Forgetti.ControlBackground}"
                  BorderBrush="{DynamicResource Forgetti.Border}"
                  BorderThickness="{DynamicResource Forgetti.BorderThickness}"
                  Effect="{DynamicResource Forgetti.ControlShadow}"
                  SnapsToDevicePixels="True">
            <Border x:Name="Knob"
                    Width="12" Height="12"
                    HorizontalAlignment="Left"
                    Margin="3,0,0,0"
                    Background="{DynamicResource Forgetti.Border}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Forgetti.Accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Forgetti.AccentForeground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Track" Property="Effect" Value="{x:Null}" />
              <Setter TargetName="Track" Property="RenderTransform" Value="{DynamicResource Forgetti.PressTransform}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A scroll bar that is a black bar on white and nothing else. Vertical only; nothing here scrolls sideways. -->
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12" />
    <Setter Property="Background" Value="{DynamicResource Forgetti.Surface}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Forgetti.Border}"
                  BorderThickness="2,0,0,0">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="{DynamicResource Forgetti.Border}" Margin="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
